# ============================================================
# GeoJSON Viewer 配置文件
# ============================================================
# 此文件控制开发和打包时的下钻功能开关
# 修改后需要重启 dev 服务或重新打包
# ============================================================

# 下钻功能开关（省→市→区县）
# -----------------------------------------------------------
# true  = 启用下钻功能（需要 geo/ 目录下的省市区数据）
# false = 禁用下钻功能（减小包体积）
# 
# 默认行为（不设置时）：
# - Web 开发/生产模式：启用
# - Chrome 扩展模式：禁用（geo 数据 100-200MB，包体太大）
# 
# 影响范围：
# - npm run dev          开发模式
# - npm run build        Web 生产构建
# - npm run pack:zip     打包 ZIP
# - npm run pack:crx     打包 CRX
# - npm run pack:both    同时打包
# ============================================================
VITE_ENABLE_DRILL_DOWN=false
