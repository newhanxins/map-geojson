# 环境变量配置文件
# 复制此文件为 .env.local 并根据需要修改

# ============================================================
# 下钻功能开关（省→市→区县）
# ============================================================
# true  = 启用下钻功能（需要 geo/ 目录下的省市区数据）
# false = 禁用下钻功能（减小包体积，无需 geo 数据）
# 
# 默认行为：
# - Web 开发/生产模式：true
# - Chrome 扩展模式：false
# ============================================================
VITE_ENABLE_DRILL_DOWN=false
